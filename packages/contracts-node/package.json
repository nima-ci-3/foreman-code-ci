{
  "name": "@foreman-code/contracts-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./server-kit": {
      "types": "./dist/serverKit.d.ts",
      "import": "./dist/serverKit.js"
    },
    "./installed-runtime-node": {
      "types": "./dist/installedRuntimeNode.d.ts",
      "import": "./dist/installedRuntimeNode.js"
    },
    "./local-client-node": {
      "types": "./dist/localClientNode.d.ts",
      "import": "./dist/localClientNode.js"
    },
    "./device-identity-node": {
      "types": "./dist/deviceIdentityNode.d.ts",
      "import": "./dist/deviceIdentityNode.js"
    },
    "./device-setup-node": {
      "types": "./dist/deviceSetupNode.d.ts",
      "import": "./dist/deviceSetupNode.js"
    },
    "./device-tls-node": {
      "types": "./dist/deviceTlsNode.d.ts",
      "import": "./dist/deviceTlsNode.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/heavy-job.mjs --build contracts-node -- tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node ../../scripts/ci-remote.mjs unit -- node ../../scripts/heavy-job.mjs -- vitest run",
    "typecheck": "node ../../scripts/ci-remote.mjs typecheck -- node ../../scripts/heavy-job.mjs -- tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node ../../scripts/ci-remote.mjs lint -- node ../../scripts/heavy-job.mjs -- eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/"
  },
  "dependencies": {
    "@foreman-code/contracts": "workspace:*",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5"
  }
}
