# Lets the managed Chromium create user namespaces for its own sandbox on
# Ubuntu 23.10+ (kernel.apparmor_restrict_unprivileged_userns=1), the same way
# Ubuntu's stock `chrome` profile does for /opt/google/chrome/chrome. Without it
# Chromium aborts with "No usable sandbox!" when started by a systemd service.
# Install: sudo install -m 0644 <this file> /etc/apparmor.d/foreman-browser-runtime
#          sudo apparmor_parser -r /etc/apparmor.d/foreman-browser-runtime

abi <abi/4.0>,
include <tunables/global>

profile foreman-browser-runtime /home/**/browser-runtime/versions/*/chromium/chrome-linux64/chrome flags=(unconfined) {
  userns,

  include if exists <local/foreman-browser-runtime>
}

# The release build starts the same Chromium once from its private build directory to collect
# its license notices (scripts/browser-runtime-install.mjs collectChromiumNotices). A deploy that
# runs as a systemd service needs the same user-namespace permission there.
profile foreman-browser-build /home/**/.browser-build-*/unit/chromium/chrome-linux64/chrome flags=(unconfined) {
  userns,

  include if exists <local/foreman-browser-build>
}

# Installing a new runtime version checks that Chromium starts from its staging directory
# before the version is activated, so the staged binary needs the same permission.
profile foreman-browser-stage /home/**/browser-runtime/versions/.stage-*/unit/chromium/chrome-linux64/chrome flags=(unconfined) {
  userns,

  include if exists <local/foreman-browser-stage>
}
